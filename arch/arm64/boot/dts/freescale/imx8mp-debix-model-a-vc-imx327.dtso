/dts-v1/;
/plugin/;

#include "imx8mp-pinfunc.h"

&i2c2 {
	status = "okay";

	vc_ctrl: controller@10 {
		compatible = "vision-components,mipi-module-controller";
		reg = <0x10>;
		#clock-cells = <0>;
		clock-frequency = <37125000>;
	};

	camera@1a {
		compatible = "sony,imx327", "sony,imx290";
		reg = <0x1a>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi0_rst>;

		clocks = <&vc_ctrl>;
		clock-names = "xclk";
		clock-frequency = <37125000>;

		vdda-supply = <&vc_ctrl>;
		vddd-supply = <&vc_ctrl>;
		vdddo-supply = <&vc_ctrl>;

		orientation = <2>; /* External camera */
		rotation = <0>;

		port {
			imx327_out: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <148500000 222750000>;
				remote-endpoint = <&mipi_csi_0_in>;
			};
		};
	};
};

&iomuxc {
	pinctrl_csi0_rst: csi0_rst_grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_STROBE__GPIO2_IO11	0x19
		>;
	};
};

&isi_0 {
	status = "okay";
};

&mipi_csi_0 {
	status = "okay";

	ports {
		port@0 {
			mipi_csi_0_in: endpoint {
				remote-endpoint = <&imx327_out>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};
